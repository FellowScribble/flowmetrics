# ==========================================================================
# Backend — variables de entorno de producción (REFERENCIA).
# ==========================================================================
# Spring Boot NO carga este archivo automáticamente. Es una plantilla para
# exportar las variables en tu shell o configurarlas en el panel de Render.
# No contiene credenciales reales. NO copies valores reales aquí.
#
# Uso en Render: configura estas variables en
#   Service -> Environment -> Environment Variables
# --------------------------------------------------------------------------

# --- Conexión a PostgreSQL (Neon) ---
# Cadena JDBC de Neon. Neon exige SSL: incluye ?sslmode=require
# (añade &channel_binding=require si Neon lo indica).
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.eu-central-1.aws.neon.tech/flowmetrics?sslmode=require
DB_USERNAME=flowmetrics_owner
DB_PASSWORD=CAMBIA_ESTO_por_tu_password_de_neon

# --- Perfil de Spring ---
# Obligatorio en Render: activa Flyway (sin baseline) + puerto PORT + cookie Secure.
SPRING_PROFILES_ACTIVE=prod

# --- CORS (opcional con el proxy de Vercel) ---
# Con el proxy same-origin el navegador no hace peticiones cross-origin, así que
# esta variable no es necesaria en producción. Defínela (lista separada por comas)
# solo si quieres permitir acceso directo al backend desde otro origen.
# CORS_ALLOWED_ORIGINS=https://flowmetrics.vercel.app

# --- Cookie de demo (opcional; el perfil `prod` ya la marca Secure) ---
# DEMO_COOKIE_SECURE=true
